import * as aws from "@pulumi/aws"
import * as pulumi from "@pulumi/pulumi"
import {
  vpc, ecsSg,
  {{#if natEnabled}}privateSubnet1, privateSubnet2,{{else}}publicSubnet1, publicSubnet2,{{/if}}
} from "./networking"
{{#if hasDatabase}}import { db } from "./store"
{{/if}}{{#if hasCache}}import { redis } from "./store"
{{/if}}{{#if hasStorage}}import { bucket } from "./store"
{{/if}}{{#if hasAlb}}import { httpListener{{#each servicesWithAlb}}, {{camel name}}Tg{{/each}} } from "./loadbalancer"
{{/if}}import * as cfg from "./config"

const prefix = "{{prefix}}"

// ── IAM: Execution Role ────────────────────────────────────────────────────────
const executionRole = new aws.iam.Role(`${prefix}-exec-role`, {
  assumeRolePolicy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [{ Effect: "Allow", Principal: { Service: "ecs-tasks.amazonaws.com" }, Action: "sts:AssumeRole" }],
  }),
  tags: { Name: `${prefix}-exec-role` },
})
new aws.iam.RolePolicyAttachment(`${prefix}-exec-role-policy`, {
  role:      executionRole.name,
  policyArn: "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
})

// ── IAM: Task Role ─────────────────────────────────────────────────────────────
const taskRole = new aws.iam.Role(`${prefix}-task-role`, {
  assumeRolePolicy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [{ Effect: "Allow", Principal: { Service: "ecs-tasks.amazonaws.com" }, Action: "sts:AssumeRole" }],
  }),
  tags: { Name: `${prefix}-task-role` },
})
{{#if hasStorage}}
new aws.iam.RolePolicy(`${prefix}-task-s3-policy`, {
  role: taskRole.id,
  policy: bucket.arn.apply(arn => JSON.stringify({
    Version: "2012-10-17",
    Statement: [{
      Effect: "Allow",
      Action: ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      Resource: [arn, `${arn}/*`],
    }],
  })),
})
{{/if}}
new aws.iam.RolePolicy(`${prefix}-task-exec-policy`, {
  role: taskRole.id,
  policy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [{
      Effect: "Allow",
      Action: ["ssmmessages:CreateControlChannel", "ssmmessages:CreateDataChannel", "ssmmessages:OpenControlChannel", "ssmmessages:OpenDataChannel"],
      Resource: "*",
    }],
  }),
})

// ── CloudWatch Log Group ───────────────────────────────────────────────────────
const logGroup = new aws.cloudwatch.LogGroup(`${prefix}-logs`, {
  retentionInDays: {{logRetentionDays}},
  tags: { Name: `${prefix}-logs` },
})

// ── ECS Cluster ────────────────────────────────────────────────────────────────
export const cluster = new aws.ecs.Cluster(`${prefix}-cluster`, {
  settings: [{ name: "containerInsights", value: "{{#if containerInsights}}enabled{{else}}disabled{{/if}}" }],
  tags: { Name: `${prefix}-cluster` },
})

new aws.ecs.ClusterCapacityProviders(`${prefix}-capacity`, {
  clusterName:       cluster.name,
  capacityProviders: ["FARGATE"],
  defaultCapacityProviderStrategies: [{ capacityProvider: "FARGATE", weight: 1, base: 1 }],
})

{{#each services}}
// ── {{name}} ({{type}}) ─────────────────────────────────────────────────────────

const {{camel name}}Env = pulumi.all([
{{#each pulumiAllSources}}  {{this}},
{{/each}}]).apply(([{{join pulumiDestructure ", "}}]: any[]) => {
  const env: { name: string; value: string }[] = []
  {{#if envFromNodeEnv}}env.push({ name: "NODE_ENV", value: "production" })
  {{/if}}{{#if envFromDb}}env.push({ name: "DATABASE_URL", value: `postgresql://{{../database.dbUser}}:${dbPass}@${dbEndpoint}:5432/{{../database.dbName}}` })
  {{/if}}{{#if envFromRedis}}env.push({ name: "REDIS_URL", value: `redis://${redisHost}:6379` })
  {{/if}}{{#if envFromBucket}}env.push({ name: "AWS_S3_BUCKET", value: bucketName })
  {{/if}}{{#if envFromRegion}}env.push({ name: "AWS_S3_REGION", value: "{{../region}}" })
  {{/if}}{{#each configVars}}  env.push({ name: "{{envVar}}", value: {{configVar}}Val })
  {{/each}}return env
})

const {{camel name}}TaskDef = new aws.ecs.TaskDefinition(`${prefix}-{{name}}-task`, {
  family:                  `${prefix}-{{name}}`,
  cpu:                     "{{cpuValue}}",
  memory:                  "{{memoryValue}}",
  networkMode:             "awsvpc",
  requiresCompatibilities: ["FARGATE"],
  executionRoleArn:        executionRole.arn,
  taskRoleArn:             taskRole.arn,
  containerDefinitions: pulumi.all([{{camel name}}Env, logGroup.name]).apply(([env, lgName]) =>
    JSON.stringify([{
      name:    "app",
      image:   "{{../fullImage}}",
      command: {{{json command}}},
      {{#if port}}portMappings: [{ containerPort: {{port}}, protocol: "tcp" }],{{/if}}
      environment: env,
      logConfiguration: {
        logDriver: "awslogs",
        options: {
          "awslogs-group":         lgName,
          "awslogs-region":        "{{../region}}",
          "awslogs-stream-prefix": "{{name}}",
        },
      },
      {{#if healthCheck}}healthCheck: {
        command:     ["CMD-SHELL", "wget -qO- http://localhost:{{port}}{{healthCheck.path}} || exit 1"],
        interval:    30,
        timeout:     5,
        retries:     3,
        startPeriod: 60,
      },{{/if}}
      essential: true,
    }])
  ),
  tags: { Name: `${prefix}-{{name}}-task` },
})

export const {{camel name}}Service = new aws.ecs.Service(`${prefix}-{{name}}`, {
  cluster:          cluster.arn,
  taskDefinition:   {{camel name}}TaskDef.arn,
  desiredCount:     {{scaling.min}},
  launchType:       "FARGATE",
  networkConfiguration: {
    subnets:        [{{#if ../natEnabled}}privateSubnet1.id, privateSubnet2.id{{else}}publicSubnet1.id, publicSubnet2.id{{/if}}],
    securityGroups: [ecsSg.id],
    assignPublicIp: {{#if ../natEnabled}}false{{else}}true{{/if}},
  },
  {{#if ../hasAlb}}{{#if targetGroupVar}}loadBalancers: [{
    targetGroupArn: {{targetGroupVar}}.arn,
    containerName:  "app",
    containerPort:  {{port}},
  }],
  {{/if}}{{/if}}deploymentCircuitBreaker: { enable: true, rollback: true },
  enableExecuteCommand: true,
  forceNewDeployment:   true,
  tags: { Name: `${prefix}-{{name}}` },
}{{#if ../hasAlb}}{{#if targetGroupVar}}, {
  dependsOn: [httpListener],
}{{/if}}{{/if}})

{{#if scalable}}
const {{camel name}}ScalingTarget = new aws.appautoscaling.Target(`${prefix}-{{name}}-scaling`, {
  maxCapacity:      {{scaling.max}},
  minCapacity:      {{scaling.min}},
  resourceId:       pulumi.all([cluster.name, {{camel name}}Service.name]).apply(([c, s]) => `service/${c}/${s}`),
  scalableDimension: "ecs:service:DesiredCount",
  serviceNamespace:  "ecs",
})

new aws.appautoscaling.Policy(`${prefix}-{{name}}-scaling-policy`, {
  name:             `${prefix}-{{name}}-cpu`,
  policyType:       "TargetTrackingScaling",
  resourceId:       {{camel name}}ScalingTarget.resourceId,
  scalableDimension: {{camel name}}ScalingTarget.scalableDimension,
  serviceNamespace:  {{camel name}}ScalingTarget.serviceNamespace,
  targetTrackingScalingPolicyConfiguration: {
    predefinedMetricSpecification: { predefinedMetricType: "ECSServiceAverageCPUUtilization" },
    targetValue:       {{scaling.cpuTarget}},
    scaleInCooldown:   300,
    scaleOutCooldown:  60,
  },
})
{{/if}}

{{/each}}
