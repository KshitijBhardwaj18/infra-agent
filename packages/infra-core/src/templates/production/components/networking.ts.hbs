import * as aws from "@pulumi/aws"

const prefix = "{{prefix}}"

// Look up AZs at deploy time rather than hardcoding `<region>a` / `<region>b`.
// Not every region exposes AZs named a/b (e.g. some opt-in regions skip
// letters), and an account may have specific AZs disabled. The dynamic
// lookup costs one extra API call at deploy time and works everywhere.
const availableAzs = aws.getAvailabilityZonesOutput({ state: "available" })

// ── VPC ─────────────────────────────────────────────────────────────────────
export const vpc = new aws.ec2.Vpc(`${prefix}-vpc`, {
  cidrBlock:          "{{vpcCidr}}",
  enableDnsHostnames: true,
  enableDnsSupport:   true,
  tags: { Name: `${prefix}-vpc` },
})

// ── Internet Gateway ─────────────────────────────────────────────────────────
const igw = new aws.ec2.InternetGateway(`${prefix}-igw`, {
  vpcId: vpc.id,
  tags: { Name: `${prefix}-igw` },
})

// ── Public Subnets ────────────────────────────────────────────────────────────
export const publicSubnet1 = new aws.ec2.Subnet(`${prefix}-public-1`, {
  vpcId:               vpc.id,
  cidrBlock:           "10.0.1.0/24",
  availabilityZone:    availableAzs.names[0],
  mapPublicIpOnLaunch: true,
  tags: { Name: `${prefix}-public-1` },
})

export const publicSubnet2 = new aws.ec2.Subnet(`${prefix}-public-2`, {
  vpcId:               vpc.id,
  cidrBlock:           "10.0.2.0/24",
  availabilityZone:    availableAzs.names[1],
  mapPublicIpOnLaunch: true,
  tags: { Name: `${prefix}-public-2` },
})

const publicRt = new aws.ec2.RouteTable(`${prefix}-public-rt`, {
  vpcId: vpc.id,
  routes: [{ cidrBlock: "0.0.0.0/0", gatewayId: igw.id }],
  tags: { Name: `${prefix}-public-rt` },
})
new aws.ec2.RouteTableAssociation(`${prefix}-public-rta-1`, { subnetId: publicSubnet1.id, routeTableId: publicRt.id })
new aws.ec2.RouteTableAssociation(`${prefix}-public-rta-2`, { subnetId: publicSubnet2.id, routeTableId: publicRt.id })

{{#if natEnabled}}
// ── Private Subnets ───────────────────────────────────────────────────────────
export const privateSubnet1 = new aws.ec2.Subnet(`${prefix}-private-1`, {
  vpcId:            vpc.id,
  cidrBlock:        "10.0.3.0/24",
  availabilityZone: availableAzs.names[0],
  tags: { Name: `${prefix}-private-1` },
})
export const privateSubnet2 = new aws.ec2.Subnet(`${prefix}-private-2`, {
  vpcId:            vpc.id,
  cidrBlock:        "10.0.4.0/24",
  availabilityZone: availableAzs.names[1],
  tags: { Name: `${prefix}-private-2` },
})

// ── NAT Gateway(s) ────────────────────────────────────────────────────────────
const natEip1 = new aws.ec2.Eip(`${prefix}-nat-eip-1`, { domain: "vpc", tags: { Name: `${prefix}-nat-eip-1` } })
export const natGw1 = new aws.ec2.NatGateway(`${prefix}-nat-1`, {
  subnetId:     publicSubnet1.id,
  allocationId: natEip1.id,
  tags: { Name: `${prefix}-nat-1` },
})

{{#if natIsDual}}
const natEip2 = new aws.ec2.Eip(`${prefix}-nat-eip-2`, { domain: "vpc", tags: { Name: `${prefix}-nat-eip-2` } })
export const natGw2 = new aws.ec2.NatGateway(`${prefix}-nat-2`, {
  subnetId:     publicSubnet2.id,
  allocationId: natEip2.id,
  tags: { Name: `${prefix}-nat-2` },
})
{{/if}}

const privateRt1 = new aws.ec2.RouteTable(`${prefix}-private-rt-1`, {
  vpcId: vpc.id,
  routes: [{ cidrBlock: "0.0.0.0/0", natGatewayId: natGw1.id }],
  tags: { Name: `${prefix}-private-rt-1` },
})
const privateRt2 = new aws.ec2.RouteTable(`${prefix}-private-rt-2`, {
  vpcId: vpc.id,
  {{#if natIsDual}}routes: [{ cidrBlock: "0.0.0.0/0", natGatewayId: natGw2.id }],{{else}}routes: [{ cidrBlock: "0.0.0.0/0", natGatewayId: natGw1.id }],{{/if}}
  tags: { Name: `${prefix}-private-rt-2` },
})
new aws.ec2.RouteTableAssociation(`${prefix}-private-rta-1`, { subnetId: privateSubnet1.id, routeTableId: privateRt1.id })
new aws.ec2.RouteTableAssociation(`${prefix}-private-rta-2`, { subnetId: privateSubnet2.id, routeTableId: privateRt2.id })
{{/if}}

// ── Security Groups ────────────────────────────────────────────────────────────
{{#if hasAlb}}
export const albSg = new aws.ec2.SecurityGroup(`${prefix}-alb-sg`, {
  vpcId: vpc.id,
  ingress: [
    { protocol: "tcp", fromPort: 80,  toPort: 80,  cidrBlocks: ["0.0.0.0/0"], description: "HTTP" },
  ],
  egress: [{ protocol: "-1", fromPort: 0, toPort: 0, cidrBlocks: ["0.0.0.0/0"] }],
  tags: { Name: `${prefix}-alb-sg` },
})
{{/if}}

export const ecsSg = new aws.ec2.SecurityGroup(`${prefix}-ecs-sg`, {
  vpcId: vpc.id,
  ingress: [
    {{#if hasAlb}}{ protocol: "tcp", fromPort: {{ecsPortRangeFrom}}, toPort: {{ecsPortRangeTo}}, securityGroups: [albSg.id], description: "From ALB" },
    {{/if}}{ protocol: "-1", fromPort: 0, toPort: 0, cidrBlocks: ["10.0.0.0/16"], description: "Internal VPC" },
  ],
  egress: [{ protocol: "-1", fromPort: 0, toPort: 0, cidrBlocks: ["0.0.0.0/0"] }],
  tags: { Name: `${prefix}-ecs-sg` },
})

{{#if needsRdsSg}}
export const rdsSg = new aws.ec2.SecurityGroup(`${prefix}-rds-sg`, {
  vpcId: vpc.id,
  ingress: [{ protocol: "tcp", fromPort: 5432, toPort: 5432, securityGroups: [ecsSg.id], description: "From ECS" }],
  egress: [{ protocol: "-1", fromPort: 0, toPort: 0, cidrBlocks: ["0.0.0.0/0"] }],
  tags: { Name: `${prefix}-rds-sg` },
})
{{/if}}

{{#if needsRedisSg}}
export const redisSg = new aws.ec2.SecurityGroup(`${prefix}-redis-sg`, {
  vpcId: vpc.id,
  ingress: [{ protocol: "tcp", fromPort: 6379, toPort: 6379, securityGroups: [ecsSg.id], description: "From ECS" }],
  egress: [{ protocol: "-1", fromPort: 0, toPort: 0, cidrBlocks: ["0.0.0.0/0"] }],
  tags: { Name: `${prefix}-redis-sg` },
})
{{/if}}
