import * as aws from "@pulumi/aws"
import { artifactsBucket } from "./artifacts"
{{#if hasStorage}}import { bucket as appBucket } from "./store"
{{/if}}

const prefix = "{{prefix}}"

// IAM role the EC2 box assumes. Gives the box (and the containers on it,
// via the instance metadata service) keyless access to: SSM (in-place
// updates), ECR (image pulls), the artifacts bucket (config sync), and
// the app storage bucket.
export const role = new aws.iam.Role(`${prefix}-ec2-role`, {
  assumeRolePolicy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [
      { Effect: "Allow", Principal: { Service: "ec2.amazonaws.com" }, Action: "sts:AssumeRole" },
    ],
  }),
  tags: { Name: `${prefix}-ec2-role` },
})

// SSM agent registration — lets the platform trigger in-place updates
// (sync from S3 + docker compose up) via RunCommand, no SSH required.
new aws.iam.RolePolicyAttachment(`${prefix}-ec2-ssm`, {
  role:      role.name,
  policyArn: "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
})

// ECR pull. GetAuthorizationToken is account-wide so must be "*"; the
// layer/image actions are scoped at pull time by the compose image refs.
new aws.iam.RolePolicy(`${prefix}-ec2-ecr`, {
  role: role.id,
  policy: JSON.stringify({
    Version: "2012-10-17",
    Statement: [
      { Effect: "Allow", Action: ["ecr:GetAuthorizationToken"], Resource: "*" },
      {
        Effect: "Allow",
        Action: ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
        Resource: "*",
      },
    ],
  }),
})

// Read the artifacts bundle (compose/.env/Caddyfile) from S3.
new aws.iam.RolePolicy(`${prefix}-ec2-artifacts`, {
  role: role.id,
  policy: artifactsBucket.arn.apply((arn) =>
    JSON.stringify({
      Version: "2012-10-17",
      Statement: [
        { Effect: "Allow", Action: ["s3:GetObject", "s3:ListBucket"], Resource: [arn, `${arn}/*`] },
      ],
    }),
  ),
})

{{#if hasStorage}}
// App storage bucket — keyless R/W for the application (matches the ECS
// task-role grant). The app reads AWS_S3_BUCKET from its .env and the
// SDK authenticates as this role via instance metadata.
new aws.iam.RolePolicy(`${prefix}-ec2-storage`, {
  role: role.id,
  policy: appBucket.arn.apply((arn) =>
    JSON.stringify({
      Version: "2012-10-17",
      Statement: [
        {
          Effect: "Allow",
          Action: ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
          Resource: [arn, `${arn}/*`],
        },
      ],
    }),
  ),
})
{{/if}}

export const instanceProfile = new aws.iam.InstanceProfile(`${prefix}-ec2-profile`, {
  role: role.name,
  tags: { Name: `${prefix}-ec2-profile` },
})
