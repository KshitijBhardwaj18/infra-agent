import * as aws from "@pulumi/aws"
import { publicSubnet1, ec2Sg } from "./networking"
import { instanceProfile } from "./iam"
import { userData } from "./cloud-init"
import {
  composeObject,
  caddyComposeObject,
  caddyfileObject,
  envObject,
} from "./artifacts"

const prefix = "{{prefix}}"

// Ubuntu 22.04 LTS (Jammy), amd64, owned by Canonical (099720109477).
const ami = aws.ec2.getAmiOutput({
  mostRecent: true,
  owners: ["099720109477"],
  filters: [
    { name: "name", values: ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"] },
    { name: "virtualization-type", values: ["hvm"] },
  ],
})

export const instance = new aws.ec2.Instance(
  `${prefix}-vm`,
  {
    ami:                      ami.id,
    instanceType:             "{{ec2InstanceType}}",
    subnetId:                 publicSubnet1.id,
    vpcSecurityGroupIds:      [ec2Sg.id],
    iamInstanceProfile:       instanceProfile.name,
    associatePublicIpAddress: true,
    userData,
    // IMDSv2 required; hop limit 2 so containers (which add one network
    // hop) can still reach the metadata service to assume the role.
    metadataOptions: {
      httpEndpoint:            "enabled",
      httpTokens:              "required",
      httpPutResponseHopLimit: 2,
    },
    rootBlockDevice: {
      volumeSize: 30,
      volumeType: "gp3",
      encrypted:  true,
    },
    tags: {
      Name:      `${prefix}-vm`,
      ManagedBy: "heizen",
      Project:   "{{project}}",
      Env:       "{{env}}",
    },
  },
  {
    // The instance must not be replaced on redeploys: app changes ride
    // through S3 + SSM (see cloud-init / the worker), and a newer
    // Canonical AMI shouldn't churn a running box. userData only refs
    // the (stable) artifacts bucket name, so it never changes anyway.
    dependsOn: [composeObject, caddyComposeObject, caddyfileObject, envObject],
    ignoreChanges: ["ami", "userData"],
  },
)

// Stable public IP — Caddy on the box faces the internet directly
// (no ALB). Users point their DNS A records here.
export const eip = new aws.ec2.Eip(`${prefix}-eip`, {
  domain:   "vpc",
  instance: instance.id,
  tags: { Name: `${prefix}-eip` },
})
