generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER AUTH TABLES — do not modify
// ============================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  systemRole     SystemRole       @default(MEMBER)
  projectMembers ProjectMember[]
  githubConnections   GithubConnection[]
  auditLogs             AuditLog[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Organization {
  id        String    @id
  name      String
  slug      String?   @unique
  logo      String?
  createdAt DateTime
  metadata  String?
  members   Member[]
  projects  Project[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PLATFORM TABLES
// ============================================

model Project {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  slug                 String
  githubOwner          String?
  githubRepo           String?
  githubBranch         String?  @default("main")
  githubInstallationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments         Environment[]
  members              ProjectMember[]

  @@unique([organizationId, slug])
}

model Environment {
  id                   String          @id @default(cuid())
  projectId            String
  type                 EnvironmentType
  // Display name, URL-safe slug (unique per project), and tier. Added for
  // multi-environment support. Nullable so the production deploy (which
  // applies the schema with `prisma db push`, not migrations) can add them
  // to the existing Environment rows without a backfill step — code resolves
  // null slug/tier from `type` via resolveEnvDeploy(). New scaffolded and
  // custom envs always set them. `tier` drives presets independently of the
  // chosen template.
  name                 String?
  slug                 String?
  tier                 EnvTier?
  awsAccountId         String?
  awsRoleArn           String?
  region               String?
  domain               String?
  pulumiStackName      String?
  pulumiBackendBucket  String?
  imageUri             String?
  setupComplete        Boolean         @default(false)
  heizenConfig         Json?
  // Parsed docker-compose.yml from the last indexing run. Used by the
  // Lightsail (staging) template to drive routing UI without re-cloning
  // at form-render time. Source of truth at deploy is the live repo.
  composeServicesCache Json?
  composeFetchedAt     DateTime?
  stackOutputs         Json?
  status               EnvironmentStatus @default(NOT_DEPLOYED)
  // Which deploy paradigm this env uses. Null = infer from `type`
  // (PRODUCTION→ECS, STAGING→LIGHTSAIL) for back-compat with envs
  // created before this field existed.
  deployStrategy       DeployStrategy?
  // EC2 instance type for the EC2_COMPOSE strategy (e.g. "t3.medium").
  ec2InstanceType      String?
  lastDeployedAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  envVars              EnvVariable[]
  deployments          Deployment[]
  resources            StackResource[]
  incidents            Incident[]
  dataSources          DataSourceConnection[]

  @@unique([projectId, slug])
}

model EnvVariable {
  id              String   @id @default(cuid())
  environmentId   String
  service         String
  key             String
  value           String
  isAutoGenerated Boolean  @default(false)
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, service, key])
}

model Deployment {
  id             String           @id @default(cuid())
  environmentId  String
  triggeredBy    String
  // DEPLOY = pulumi up (default — existing rows preserve their meaning).
  // DESTROY = pulumi destroy. Separate row per teardown so the audit
  // trail and log stream work identically to a deploy.
  kind           DeploymentKind   @default(DEPLOY)
  commitSha      String?
  commitMessage  String?
  imageUri       String?
  status         DeploymentStatus @default(QUEUED)
  errorMessage   String?
  stackOutputs   Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  environment    Environment      @relation(fields: [environmentId], references: [id])
  logs           DeploymentLog[]
}

model DeploymentLog {
  id           String          @id @default(cuid())
  deploymentId String
  timestamp    DateTime        @default(now())
  phase        DeploymentPhase
  level        String
  message      String
  deployment   Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
}

model StackResource {
  id            String   @id @default(cuid())
  environmentId String
  pulumiUrn     String
  type          String
  name          String
  properties    Json
  dependencies  String[]
  updatedAt     DateTime @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, pulumiUrn])
  @@index([environmentId, type])
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model GithubConnection {
  id              String            @id @default(cuid())
  installationId  String            @unique
  accountLogin    String
  accountType     GithubAccountType
  addedByUserId   String?
  createdAt       DateTime          @default(now())
  addedBy         User?             @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([accountLogin])
}

model AuditLog {
  id            String        @id @default(cuid())
  actorId       String?
  action        AuditAction
  resourceType  AuditResource
  resourceId    String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
}

// ============================================
// ENUMS
// ============================================

enum EnvironmentType {
  STAGING
  PRODUCTION
  CUSTOM
}

// Behavioral tier for an environment, independent of its display identity
// (name/slug) and its template (deployStrategy). Drives presets, the
// prefix/bucket envSlug semantics, and heizenConfig.env. STAGING/PRODUCTION
// rows backfill to the matching tier.
enum EnvTier {
  STAGING
  PRODUCTION
}

enum EnvironmentStatus {
  NOT_DEPLOYED
  DEPLOYING
  LIVE
  FAILED
  DESTROYING
  DESTROYED
}

// Deploy paradigm for an environment.
//   ECS          — Fargate task-per-service (production template)
//   EC2_COMPOSE  — single EC2 box running docker-compose (ec2 template)
//   LIGHTSAIL    — single Lightsail VM running docker-compose (lightsail template)
enum DeployStrategy {
  ECS
  EC2_COMPOSE
  LIGHTSAIL
}

enum DeploymentStatus {
  QUEUED
  DEPLOYING
  SUCCESS
  FAILED
  CANCELLED
}

enum DeploymentKind {
  DEPLOY
  DESTROY
}

enum DeploymentPhase {
  PULUMI
  SYSTEM
}

enum SystemRole {
  MEMBER
  ADMIN
}

enum ProjectRole {
  OWNER
  DEPLOYER
  VIEWER
}

enum GithubAccountType {
  USER
  ORGANIZATION
}

enum AuditAction {
  DEPLOY_TRIGGERED
  DESTROY_TRIGGERED
  ENV_VARS_REPLACED
  GITHUB_CONNECTION_ADDED
  GITHUB_CONNECTION_REMOVED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DELETED
  PROJECT_DELETED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_ROLE_CHANGED
  PROJECT_MEMBER_REMOVED
}

enum AuditResource {
  PROJECT
  ENVIRONMENT
  USER
  GITHUB_CONNECTION
  PROJECT_MEMBER
}

// ── Observability / incidents ───────────────────────────────────────────────
// An incident is a detected (or manually-raised) problem on a deployed
// environment. Source records where it came from (a health probe, a
// Grafana alert, the agent's analysis, or a human). The agent enriches
// incidents with a suggested remedy. `fingerprint` dedupes recurring
// signals so a flapping check doesn't spawn a new incident each scan.
model Incident {
  id             String           @id @default(cuid())
  environmentId  String
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  source         IncidentSource
  title          String
  detail         String?
  suggestedRemedy String?
  // Stable key for an underlying condition (e.g. "http-5xx", "ec2-cpu",
  // "grafana:<ruleUid>") used to reopen/update instead of duplicating.
  fingerprint    String?
  metadata       Json?
  // Structured output of the intelligence layer (root cause, evidence,
  // confidence, correlated deployment, suggested actions).
  analysis       Json?
  // Recurrence tracking (Sentry-style grouping): how many scans saw
  // this signal firing, and when it was last observed.
  occurrences    Int              @default(1)
  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  environment    Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, status])
  @@unique([environmentId, fingerprint])
}

enum IncidentSeverity {
  CRITICAL
  WARNING
  INFO
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentSource {
  HEALTHCHECK
  AGENT
  MANUAL
  DEPLOYMENT
  LOGS
  METRICS
}

// A per-environment connection to an external observability source
// (e.g. the customer's own Grafana/Loki). `config` is an encrypted JSON
// blob (endpoint, token, selector, labels…); readers decrypt it on use.
model DataSourceConnection {
  id            String      @id @default(cuid())
  environmentId String
  type          String
  displayName   String
  config        String
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
}
