generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER AUTH TABLES — do not modify
// ============================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Organization {
  id        String    @id
  name      String
  slug      String?   @unique
  logo      String?
  createdAt DateTime
  metadata  String?
  members   Member[]
  projects  Project[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PLATFORM TABLES
// ============================================

model Project {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  slug                 String
  githubOwner          String?
  githubRepo           String?
  githubBranch         String?  @default("main")
  githubInstallationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments         Environment[]

  @@unique([organizationId, slug])
}

model Environment {
  id                   String          @id @default(cuid())
  projectId            String
  type                 EnvironmentType
  awsAccountId         String?
  awsRoleArn           String?
  region               String?
  domain               String?
  pulumiStackName      String?
  pulumiBackendBucket  String?
  ecrUri               String?
  codebuildProjectName String?
  setupComplete        Boolean         @default(false)
  heizenConfig         Json?
  stackOutputs         Json?
  status               EnvironmentStatus @default(NOT_DEPLOYED)
  lastDeployedAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  envVars              EnvVariable[]
  deployments          Deployment[]
  resources            StackResource[]

  @@unique([projectId, type])
}

model EnvVariable {
  id              String   @id @default(cuid())
  environmentId   String
  service         String
  key             String
  value           String
  isAutoGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, service, key])
}

model Deployment {
  id             String           @id @default(cuid())
  environmentId  String
  triggeredBy    String
  commitSha      String?
  commitMessage  String?
  dockerfilePath String?
  ecrUri         String?
  imageTag       String?
  status         DeploymentStatus @default(QUEUED)
  errorMessage   String?
  stackOutputs   Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  environment    Environment      @relation(fields: [environmentId], references: [id])
  logs           DeploymentLog[]
}

model DeploymentLog {
  id           String          @id @default(cuid())
  deploymentId String
  timestamp    DateTime        @default(now())
  phase        DeploymentPhase
  level        String
  message      String
  deployment   Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
}

model StackResource {
  id            String   @id @default(cuid())
  environmentId String
  pulumiUrn     String
  type          String
  name          String
  properties    Json
  dependencies  String[]
  updatedAt     DateTime @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, pulumiUrn])
  @@index([environmentId, type])
}

// ============================================
// ENUMS
// ============================================

enum EnvironmentType {
  STAGING
  PRODUCTION
}

enum EnvironmentStatus {
  NOT_DEPLOYED
  DEPLOYING
  LIVE
  FAILED
  DESTROYING
  DESTROYED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  PUSHING
  DEPLOYING
  SUCCESS
  FAILED
  CANCELLED
}

enum DeploymentPhase {
  DOCKER_BUILD
  DOCKER_PUSH
  PULUMI
  SYSTEM
}
