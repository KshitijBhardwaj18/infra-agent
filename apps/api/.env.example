DATABASE_URL=postgresql://heizen:heizen@localhost:5432/heizen
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
# GitHub App configuration:
#   - Account Permissions > Email addresses (Read-only) for real emails
#   - User authorization callback URL:  http://localhost:3001/api/auth/callback/github
#   - Setup URL (after install):        http://localhost:3001/api/github/callback
#     (the API handles the callback, verifies signed state, and redirects to the project)
#   - Webhook URL:                      http://localhost:3001/api/github/webhooks
#     (handles installation.deleted and installation_repositories events)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Random secret used to HMAC-sign the GitHub install state token (run: openssl rand -hex 32)
GITHUB_STATE_SECRET=
# Webhook secret configured in the GitHub App settings (run: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Cross-subdomain cookie domain (production only). Leave unset locally.
# Must start with a dot, e.g. .sre-agent.opengig.work
AUTH_COOKIE_DOMAIN=
PULUMI_CONFIG_PASSPHRASE=
# Heizen platform AWS credentials — used to assume customer deploy roles via STS.
# The IAM user/role for these keys must be trusted by customer roles (see PLATFORM_AWS_ACCOUNT_ID).
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
# Optional, only if the platform credentials are temporary/session-based.
PLATFORM_AWS_SESSION_TOKEN=
# Pre-installed Pulumi deps dir — symlinked into generated infra code to skip install on each deploy.
# Local setup: mkdir -p /pulumi-deps && cp apps/api/pulumi-base-package.json /pulumi-deps/package.json && cd /pulumi-deps && bun install
PULUMI_BASE_DEPS_DIR=/pulumi-deps
PORT=3001
CORS_ORIGIN=http://localhost:3000
