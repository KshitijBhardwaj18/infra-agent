DATABASE_URL=postgresql://heizen:heizen@localhost:5432/heizen
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
# GitHub App configuration:
#   - Account Permissions > Email addresses (Read-only) for real emails
#   - User authorization callback URL:  http://localhost:3001/api/auth/callback/github
#   - Setup URL (after install):        http://localhost:3001/api/github/callback
#     (the API handles the callback, verifies signed state, and redirects to the project)
#   - Webhook URL:                      http://localhost:3001/api/github/webhooks
#     (handles installation.deleted and installation_repositories events)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Random secret used to HMAC-sign the GitHub install state token (run: openssl rand -hex 32)
GITHUB_STATE_SECRET=
# Webhook secret configured in the GitHub App settings (run: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
# Local dev only: set to "1" together with NODE_ENV=development to skip webhook
# signature verification when GITHUB_WEBHOOK_SECRET is unset. Ignored in every
# other environment.
ALLOW_UNSIGNED_GITHUB_WEBHOOKS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Cross-subdomain cookie domain. Must start with a dot. Required when the
# admin app runs on its own subdomain (admin.host).
#   - Local dev with admin.localhost:3000:  AUTH_COOKIE_DOMAIN=.localhost
#   - Production (e.g. app.heizen.app + admin.heizen.app): AUTH_COOKIE_DOMAIN=.heizen.app
# Leave unset only when admin lives at path-prefix /admin on the same origin.
AUTH_COOKIE_DOMAIN=
PULUMI_CONFIG_PASSPHRASE=
# Heizen platform AWS credentials — used to assume customer deploy roles via STS.
# The IAM user/role for these keys must be trusted by customer roles (see PLATFORM_AWS_ACCOUNT_ID).
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
# Optional, only if the platform credentials are temporary/session-based.
PLATFORM_AWS_SESSION_TOKEN=
# Pre-installed Pulumi deps dir — symlinked into generated infra code to skip install on each deploy.
# Local setup: mkdir -p /pulumi-deps && cp apps/api/pulumi-base-package.json /pulumi-deps/package.json && cd /pulumi-deps && bun install
PULUMI_BASE_DEPS_DIR=/pulumi-deps
PORT=3001
# Comma-separated list of allowed origins (user app + admin app).
#   - Local dev: http://localhost:3000,http://localhost:3002
#   - Prod:      https://app.heizen.app,https://admin.heizen.app
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
# Admin app origin — used by GitHub callbacks and other admin redirects.
ADMIN_ORIGIN=http://localhost:3002
# Single-org bootstrap. On API startup, a default Organization is auto-created
# if none exist. These vars control its name/slug.
DEFAULT_ORG_NAME=Heizen
DEFAULT_ORG_SLUG=heizen
# Email of the first ADMIN user. When a user with this email signs up (or on
# every boot if they already exist), their systemRole is promoted to ADMIN.
# Leave unset to skip auto-promotion.
BOOTSTRAP_ADMIN_EMAIL=
# Password for the auto-created admin on a fresh DB. Min 12 characters. Only
# read on first boot when BOOTSTRAP_ADMIN_EMAIL is set and the User table is
# empty. Rotate via /admin/users in the UI after first login.
BOOTSTRAP_ADMIN_PASSWORD=
# GitHub App installation that owns the org-level connection. If set and no
# connections exist yet, the API will auto-register it on first boot. Leave
# unset to let admins add connections through the admin panel.
BOOTSTRAP_GITHUB_INSTALLATION_ID=
